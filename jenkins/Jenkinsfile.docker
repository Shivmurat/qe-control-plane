pipeline {
        PYTHON_ENV = 'venv'
    }

    stages {

        stage('Checkout Source Code') {

            steps {

                checkout scm
            }
        }

        stage('Verify Tooling') {

            steps {

                sh 'python3 --version'

                sh 'docker --version'
            }
        }

        stage('Create Virtual Environment') {

            steps {

                sh 'python3 -m venv ${PYTHON_ENV}'
            }
        }

        stage('Install Dependencies') {

            steps {

                sh '. ${PYTHON_ENV}/bin/activate && pip install -r requirements.txt'
            }
        }

        stage('Build Docker Image') {

            steps {

                sh 'docker build -t qe-control-plane:latest -f docker/Dockerfile .'
            }
        }

        stage('Execute Docker Container') {

            steps {

                sh '''

                docker run --rm qe-control-plane:latest

                '''
            }
        }
    }

    post {

        success {

            echo 'Docker pipeline executed successfully'
        }

        failure {

            echo 'Docker pipeline execution failed'
        }

        always {

            cleanWs()
        }
    }
}